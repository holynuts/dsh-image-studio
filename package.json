{
  "name": "dsh-image-studio",
  "version": "0.3.1",
  "type": "module",
  "description": "Generate images with Nano Banana, ChatGPT Image, fal, Replicate or any OpenAI-compatible endpoint — every result lands in a searchable library, and the panel lets you compare one prompt across models.",
  "icon": "icon.svg",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "SPEC.md",
    "docs",
    "LICENSE",
    "README.zh-CN.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "scripts": {
    "test": "node --test test/*.test.js"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "author": "holynuts",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/holynuts/dsh-image-studio.git"
  },
  "homepage": "https://github.com/holynuts/dsh-image-studio#readme",
  "bugs": {
    "url": "https://github.com/holynuts/dsh-image-studio/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "image-generation",
    "image-studio",
    "nano-banana",
    "gemini",
    "fal",
    "replicate"
  ]
}
